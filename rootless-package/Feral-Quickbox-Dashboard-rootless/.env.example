# Example of ~/.config/feral-quickbox/config.env (written by install.sh). Do not put real credentials here.
HOME_PATH=/home/youruser
# PASSWORD_HASH="$2y$10$...generated by install.sh..."
# Optional: show real account quota instead of filesystem capacity (measured by a throttled background du)
# QUOTA_GB=250
# QUOTA_REFRESH=900
# Optional app shortcuts: Label|url;Label|url   (url = /path or https://...)
# APPS="ruTorrent|/rutorrent/;qBittorrent|/qbittorrent/"
